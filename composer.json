{
  "name": "php-sap/interfaces",
  "description": "Interfaces for implementing the PHP/SAP API. See https://php-sap.github.io for details.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Gregor J.",
      "email": "gregor-j@users.noreply.github.com",
      "role": "developer"
    }
  ],
  "homepage": "https://php-sap.github.io",
  "keywords": [
    "phpsap",
    "php-sap",
    "interfaces"
  ],
  "conflict":  {
    "kba-team/php-sap": "*"
  },
  "minimum-stability": "stable",
  "require": {
    "php": "^8.1",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "phpsap\\interfaces\\": "src/"
    }
  },
  "scripts": {
    "ci": [
      "@composer validate --strict",
      "@php -l src/",
      "@php vendor/bin/phpstan analyse --configuration=phpstan.neon",
      "@php vendor/bin/phpcs"
    ]
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2.3",
    "squizlabs/php_codesniffer": "^4.0"
  }
}
